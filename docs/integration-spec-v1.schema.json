{
  "spec_version": "1.0-DRAFT",
  "status": "DRAFT — UNCONFIRMED. Поля/типы выведены из модели Attendee и подлежат подтверждению downstream-системой (Story 4.1, Saved Questions).",
  "description": "Машиночитаемый контракт одного объекта attendee в attendees.json. Единый источник правды для export serializer (Story 4.3) и contract-теста (test_export_contract.py).",
  "object": "attendee",
  "fields": [
    {"name": "attendee_id", "type": "integer", "required": true, "nullable": false, "source": "Attendee.id"},
    {"name": "event_id", "type": "integer", "required": true, "nullable": false, "source": "Attendee.request.event.id"},
    {"name": "event_code", "type": "string", "required": true, "nullable": false, "source": "Attendee.request.event.event_code"},
    {"name": "category", "type": "string", "required": true, "nullable": true, "source": "Attendee.category.name"},
    {"name": "status", "type": "string", "required": true, "nullable": false, "enum": ["ready"], "source": "Attendee.status"},
    {"name": "surname", "type": "string", "required": true, "nullable": false, "source": "Attendee.surname"},
    {"name": "firstname", "type": "string", "required": true, "nullable": false, "source": "Attendee.firstname"},
    {"name": "patronymic", "type": "string", "required": false, "nullable": true, "source": "Attendee.patronymic"},
    {"name": "transcription", "type": "string", "required": true, "nullable": false, "source": "Attendee.transcription"},
    {"name": "birth_date", "type": "date", "required": true, "nullable": true, "source": "Attendee.birthDate"},
    {"name": "iin", "type": "string", "required": true, "nullable": true, "pattern": "^[0-9]{12}$", "source": "Attendee.iin (decrypted; null для нерезидента)", "pii": true},
    {"name": "is_resident", "type": "boolean", "required": true, "nullable": false, "source": "Attendee.is_resident"},
    {"name": "sex_id", "type": "string", "required": true, "nullable": false, "source": "Attendee.sexId (directories.Sex id)"},
    {"name": "country_id", "type": "string", "required": true, "nullable": false, "source": "Attendee.countryId (directories.Country id)"},
    {"name": "post", "type": "string", "required": true, "nullable": false, "source": "Attendee.post"},
    {"name": "doc_type_id", "type": "string", "required": true, "nullable": false, "source": "Attendee.docTypeId (directories.DocumentType id)"},
    {"name": "doc_series", "type": "string", "required": true, "nullable": false, "source": "Attendee.docSeries"},
    {"name": "doc_number", "type": "string", "required": false, "nullable": true, "source": "Attendee.docNumber"},
    {"name": "doc_begin", "type": "date", "required": false, "nullable": true, "source": "Attendee.docBegin"},
    {"name": "doc_end", "type": "date", "required": false, "nullable": true, "source": "Attendee.docEnd"},
    {"name": "doc_issue", "type": "string", "required": true, "nullable": false, "source": "Attendee.docIssue"},
    {"name": "visit_objects", "type": "string", "required": true, "nullable": false, "source": "Attendee.visitObjects"},
    {"name": "date_add", "type": "datetime", "required": true, "nullable": false, "source": "Attendee.dateAdd (ISO8601)"},
    {"name": "photo_file", "type": "string", "required": true, "nullable": false, "pattern": "^photos/", "source": "путь в ZIP: photos/<attendee_id>.<ext>"},
    {"name": "doc_scan_file", "type": "string", "required": true, "nullable": false, "pattern": "^documents/", "source": "путь в ZIP: documents/<attendee_id>.<ext>"}
  ],
  "archive": {
    "name_pattern": "export_<event_id>_<category>_<timestamp>.zip",
    "contents": ["attendees.json", "photos/<attendee_id>.<ext>", "documents/<attendee_id>.<ext>"]
  }
}
