# Security
SECRET_KEY=change-me-secret-key
DEBUG=False

# Database (PostgreSQL)
DB_NAME=change-me-db-name
DB_USER=change-me-db-user
DB_PASSWORD=change-me-db-password
DB_HOST=change-me-db-host
DB_PORT=5432

# Internal API Keys
AVALON_API_KEY=
FERNET_KEYS=your-fernet-key-here

# Email
OPERATOR_PUBLIC_ORIGIN=https://accreditation.example.com
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.invalid

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
REDIS_CACHE_URL=redis://redis:6379/1
KAZENERGY_API_KEY=
