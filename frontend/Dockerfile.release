FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build -- --base=/workspace/

FROM nginx:stable-alpine@sha256:caf4e1e032a20f9c3c5e28fc7f25ffd768ad8677b4975c54193075997b3a97e3
# Этап F: уже выпущенные исправления дистрибутива (Medium/Low с исправлением по данным сканера).
RUN apk upgrade --no-cache && apk add --no-cache --upgrade 'libxml2>=2.13.9-r3'
COPY release.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/ /usr/share/nginx/html/workspace/
EXPOSE 8443
